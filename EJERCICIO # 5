//PROGRAMA QUE CONVIERTE UN VALOR EN GRADOS FAHRENHEIT A GRADOS CELSIUS
PROCESO CONVERSIONCELSIUS
 ESCRIBIR "PROGRAMA QUE CONVIERTE UN VALOR EN GRADOS FAHRENHEIT A GRADOS CELSIUS"
 ESCRIBIR "."
 ESCRIBIR "INGRESA VALOR"
 LEER VALOR
 CONVERSION = ( VALOR - 32 ) * 5/9 
 ESCRIBIR "."
 ESCRIBIR "EL VALOR DADO ES " , VALOR 
 ESCRIBIR "EL VALOR CONVERTIDO A GRADOS CELSIUS ES " , CONVERSION
FINPROCESO
