//programa que calcula la hipotenusa de un triangulo rectangulo
PROCESO hipotenusa
 ESCRIBIR "PROGRAMA QUE CALCULA LA HIPOTENUSA DE UN TRIANGULO RECTANGULO"
 ESCRIBIR "."
 ESCRIBIR "."
 ESCRIBIR "INGRESE MEDIDA DEL CATETO Y"
 LEER CATETOY
 ESCRIBIR "INGRESE MEDIDA DEL CATETO X"
 LEER CATETOX
 HIPOTENUSA = RAIZ( CATETOY ^ 2 + CATETOX ^ 2 ) 
 ESCRIBIR "."
 ESCRIBIR "CATETO Y = " , CATETOY
 ESCRIBIR "CATETO X = " , CATETOX
 ESCRIBIR "LA HIPOTENUSA DEL TRIANGULO RECTANGULO ES " , HIPOTENUSA
FINPROCESO
