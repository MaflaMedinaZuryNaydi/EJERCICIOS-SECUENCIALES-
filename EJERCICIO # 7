//PROGRAMA QUE RECIBE UNA CANTIDAD DE MINUTOS Y MUESTRA EN PANTALLA A CUANTAS HORAS Y MINUTOS CORESPONDEN
PROCESO HORASYMINUTOS
 ESCRIBIR "PROGRAMA QUE RECIBE UNA CANTIDAD DE MINUTOS, LOS MUESTRA EN HORA Y MINUTOS"
 ESCRIBIR "INGRESAR CANTIDAD DE MINUTOS"
 LEER MINUTOS
 HORAS = TRUNC(MINUTOS/60)
 RES = MINUTOS/60 - HORAS 
 MINU = RES * 60 
 ESCRIBIR "HORAS :" , HORAS
 ESCRIBIR "MINUTOS :" , MINU
FINPROCESO
