//PROGRAMA QUE RECIBE TRES NUMEROS Y CALCULA SU MEDIA
PROCESO CALCULODEMEDIA
 ESCRIBIR "PROGRAMA QUE CALCULA LA MEDIA DE 3 NUMEROS"
 ESCRIBIR "."
 ESCRIBIR "DIGITE NUMERO 1"
 LEER NUMERO1
 ESCRIBIR "DIGITE NUMERO 2"
 LEER NUMERO2
 ESCRIBIR "DIGITE NUMERO 3"
 LEER NUMERO3
 MEDIA = (NUMERO1 + NUMERO2 + NUMERO3) / 3
 ESCRIBIR "."
 ESCRIBIR "EL VALOR DE NUMERO 1 ES " , NUMERO1 
 ESCRIBIR "EL VALOR DE NUMERO 2 ES " , NUMERO2 
 ESCRIBIR "EL VALOR DE NUMERO 3 ES " , NUMERO3 
 ESCRIBIR "SU MEDIA ES " , MEDIA 
FINPROCESO 
