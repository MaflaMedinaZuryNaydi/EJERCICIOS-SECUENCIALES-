//PROGRAMA PARA CALCULAR EL PERIMETRO Y AREA DE UN RECTANGULO DADA SU BASE Y ALTURA
PROCESO AREAYPERIMETRO
 ESCRIBIR "PROGRAMA QUE CALCULA EL PERIMETRO Y AREA DE UN RECTANGULO"
 ESCRIBIR "."
 ESCRIBIR "." 
 ESCRIBIR "INGRESE LA BASE"
 LEER BASE 
 ESCRIBIR "INGRESE ALTURA"
 LEER ALTURA
 ESCRIBIR "."
 PERIMETRO = 2 * ( BASE + ALTURA ) 
 AREA = BASE * ALTURA 
 ESCRIBIR "EL RECTANGULO DE BASE " , BASE , " Y ALTURA " , ALTURA , " TIENE UN PERIMETRO DE " , PERIMETRO , " Y UN AREA DE " , AREA 
FINPROCESO
